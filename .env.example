NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
APP_BASE_URL=http://localhost:3000

# Server-only. The service role key is used only by the verified payment webhook.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional PayMongo Hosted Checkout v2. Leave blank to keep online payments hidden.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Only channels enabled for this merchant account; supported here: gcash, qrph, card
PAYMONGO_PAYMENT_METHOD_TYPES=
